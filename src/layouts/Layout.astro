---
import { Font } from 'astro:assets';
import '@/styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Kardia" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>Astro Basics</title>

    {/* Fraunces is the hero display face: preload it. Inter is body/label text and
        is intentionally not preloaded to avoid competing for critical bandwidth. */}
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-inter" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
